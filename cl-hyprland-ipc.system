(in-package "CL-USER")

(defvar *cl-hyprland-ipc-source-dir*
  (merge-pathnames "Github/cl-hyprland-ipc/" (translate-logical-pathname "EXTERN:")))
(defvar *cl-hyprland-ipc-binary-dir* (binary-directory *cl-hyprland-source-dir*
						       #+sbcl-only "sbcl-only"))

(mk:defsystem cl-hyprland-ipc
  :source-pathname *cl-hyprland-ipc-source-dir*
  :binary-pathname *cl-hyprland-ipc-binary-dir*
  :source-extension "lisp"
  :depends-on (:alexandria
	       :babel
	       "jzon" ;; :com.inuoe.jzon
	       #+sbcl
	       :sb-bsd-sockets
	       #-sbcl
	       "usocket"
	       :split-sequence
	       :uiop)
  :components ((:module "src"
		:components ((:file "package")
			     (:file "sockets"
			      :depends-on ("package"))
			     (:file "hyprctl"
			      :depends-on ("sockets"))
			     (:file "events"
			      :depends-on ("sockets"))))))

#+nil
(mk:oos :cl-hyprland-ipc :load :compile-during-load t)

