	       (user::shell-command-to-string "ss -lx|grep -m 1 hypr| sed -e 's|.*hypr/\\(.*\\)/\\.sock.*|\\1|g'"))
(user:getenv  "HYPRLAND_INSTANCE_SIGNATURE")
